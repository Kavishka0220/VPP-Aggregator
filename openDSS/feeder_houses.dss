Clear
! New circuit.example1 bus1=sourcebus pu=1.1 basekv=33 z1=[0.1, 0.2] z0=[0.3, 0.4]

! ========= LINE MODEL (33 kV & simple LV) =========
! new linecode.lc33 nphases=3 basefreq=50 units=km R1=0.01273 X1=0.29333 R0=0.3864 X0=1.29687 C1=12.74 C0=7.751
! new linecode.LVCode nphases=3 r1=0.44 x1=0.1131 r0=0.44 x0=0.1131 units=km



//Transformer: 160 kVA, 33 kV / 0.415 kV, Delta / Yn
! new transformer.tx1 phases=3 windings=2 xhl=3.78 wdg=1 bus=bus33 conn=delta kv=33 kva=160 %r=0.656 wdg=2 bus=buslv conn=wye   kv=0.415 kva=160 %r=0.656

set defaultbasefrequency=50

! ========= CIRCUIT =========
new circuit.VPP11 basekv=0.4 pu=1.0 phases=3 bus1=SourceBus
edit vsource.Source bus1=SourceBus basekv=0.4 pu=1.0 phases=3

! ========= LINE MODEL (simple LV) =========
new linecode.LVCode nphases=3 r1=0.44 x1=0.1131 r0=0.44 x0=0.1131 units=km

! ========= FEEDER TOPOLOGY =========
! Source -> N0 -> N1 -> ... -> N20 -> NBESS (approx 660m total)
new line.L0  bus1=SourceBus.1.2.3 bus2=N0.1.2.3    linecode=LVCode length=0.03 units=km
new line.L1  bus1=N0.1.2.3         bus2=N1.1.2.3    linecode=LVCode length=0.03 units=km
new line.L2  bus1=N1.1.2.3         bus2=N2.1.2.3    linecode=LVCode length=0.03 units=km
new line.L3  bus1=N2.1.2.3         bus2=N3.1.2.3    linecode=LVCode length=0.03 units=km
new line.L4  bus1=N3.1.2.3         bus2=N4.1.2.3    linecode=LVCode length=0.03 units=km
new line.L5  bus1=N4.1.2.3         bus2=N5.1.2.3    linecode=LVCode length=0.03 units=km
new line.L6  bus1=N5.1.2.3         bus2=N6.1.2.3    linecode=LVCode length=0.03 units=km
new line.L7  bus1=N6.1.2.3         bus2=N7.1.2.3    linecode=LVCode length=0.03 units=km
new line.L8  bus1=N7.1.2.3         bus2=N8.1.2.3    linecode=LVCode length=0.03 units=km
new line.L9  bus1=N8.1.2.3         bus2=N9.1.2.3    linecode=LVCode length=0.03 units=km
new line.L10 bus1=N9.1.2.3        bus2=N10.1.2.3   linecode=LVCode length=0.03 units=km
new line.L11 bus1=N10.1.2.3      bus2=N11.1.2.3   linecode=LVCode length=0.03 units=km
new line.L12 bus1=N11.1.2.3      bus2=N12.1.2.3   linecode=LVCode length=0.03 units=km
new line.L13 bus1=N12.1.2.3      bus2=N13.1.2.3   linecode=LVCode length=0.03 units=km
new line.L14 bus1=N13.1.2.3      bus2=N14.1.2.3   linecode=LVCode length=0.03 units=km
new line.L15 bus1=N14.1.2.3      bus2=N15.1.2.3   linecode=LVCode length=0.03 units=km
new line.L16 bus1=N15.1.2.3      bus2=N16.1.2.3   linecode=LVCode length=0.03 units=km
new line.L17 bus1=N16.1.2.3      bus2=N17.1.2.3   linecode=LVCode length=0.03 units=km
new line.L18 bus1=N17.1.2.3      bus2=N18.1.2.3   linecode=LVCode length=0.03 units=km
new line.L19 bus1=N18.1.2.3      bus2=N19.1.2.3   linecode=LVCode length=0.03 units=km
new line.L20 bus1=N19.1.2.3      bus2=N20.1.2.3   linecode=LVCode length=0.03 units=km
new line.L21 bus1=N20.1.2.3     bus2=NBESS.1.2.3 linecode=LVCode length=0.03 units=km

! ========= LOADS =========
! Single Phase Nodes: 0, 5, 7, 10, 11, 13, 17, 18 (kv=0.23)
new load.Load0  bus1=N0.1  phases=1 kv=0.23 kw=5 kvar=1
new load.Load5  bus1=N5.3  phases=1 kv=0.23 kw=5 kvar=1
new load.Load7  bus1=N7.2  phases=1 kv=0.23 kw=5 kvar=1
new load.Load10 bus1=N10.2 phases=1 kv=0.23 kw=5 kvar=1
new load.Load11 bus1=N11.1 phases=1 kv=0.23 kw=5 kvar=1
new load.Load13 bus1=N13.2 phases=1 kv=0.23 kw=5 kvar=1
new load.Load17 bus1=N17.3 phases=1 kv=0.23 kw=5 kvar=1
new load.Load18 bus1=N18.2 phases=1 kv=0.23 kw=5 kvar=1

! Three Phase Nodes (kv=0.4)
new load.Load1  bus1=N1.1.2.3  phases=3 kv=0.4 kw=5 kvar=1
new load.Load2  bus1=N2.1.2.3  phases=3 kv=0.4 kw=5 kvar=1
new load.Load3  bus1=N3.1.2.3  phases=3 kv=0.4 kw=5 kvar=1
new load.Load4  bus1=N4.1.2.3  phases=3 kv=0.4 kw=5 kvar=1
new load.Load6  bus1=N6.1.2.3  phases=3 kv=0.4 kw=5 kvar=1
new load.Load8  bus1=N8.1.2.3  phases=3 kv=0.4 kw=5 kvar=1
new load.Load9  bus1=N9.1.2.3  phases=3 kv=0.4 kw=5 kvar=1
new load.Load12 bus1=N12.1.2.3 phases=3 kv=0.4 kw=5 kvar=1
new load.Load14 bus1=N14.1.2.3 phases=3 kv=0.4 kw=5 kvar=1
new load.Load15 bus1=N15.1.2.3 phases=3 kv=0.4 kw=5 kvar=1
new load.Load16 bus1=N16.1.2.3 phases=3 kv=0.4 kw=5 kvar=1
new load.Load19 bus1=N19.1.2.3 phases=3 kv=0.4 kw=5 kvar=1
new load.Load20 bus1=N20.1.2.3 phases=3 kv=0.4 kw=5 kvar=1

! ========= PV (Single Phase Updates) =========
! Node 3 remains 3-phase as per your previous Load3 definition
new generator.PV3   bus1=N3.1.2.3  phases=3 kv=0.4 kw=0 model=1

! Single Phase PV (Must match the Load phase exactly)
new generator.PV5   bus1=N5.3      phases=1 kv=0.23 kw=0 model=1
new generator.PV7   bus1=N7.2      phases=1 kv=0.23 kw=0 model=1
new generator.PV10  bus1=N10.2     phases=1 kv=0.23 kw=0 model=1
new generator.PV11  bus1=N11.1     phases=1 kv=0.23 kw=0 model=1
new generator.PV13  bus1=N13.2     phases=1 kv=0.23 kw=0 model=1
new generator.PV17  bus1=N17.3     phases=1 kv=0.23 kw=0 model=1
new generator.PV18  bus1=N18.2     phases=1 kv=0.23 kw=0 model=1

! Nodes 15, 19, 20 remain 3-phase
new generator.PV15  bus1=N15.1.2.3 phases=3 kv=0.4 kw=0 model=1
new generator.PV19  bus1=N19.1.2.3 phases=3 kv=0.4 kw=0 model=1
new generator.PV20  bus1=N20.1.2.3 phases=3 kv=0.4 kw=0 model=1

! ========= STORAGE (home_batt_indices = [3,5], bess_index = 21) =========
new storage.Batt3 bus1=N3.1.2.3 phases=3 kv=0.4 kwrated=5  kwhrated=13.5 %stored=50 state=idling dispmode=External %effcharge=95 %effdischarge=95
new storage.Batt5 bus1=N5.3 phases=1 kv=0.23 kwrated=5  kwhrated=13.5 %stored=50 state=idling dispmode=External %effcharge=95 %effdischarge=95
new storage.BESS  bus1=NBESS.1.2.3 phases=3 kv=0.4 kwrated=40 kwhrated=120 %stored=50 state=idling dispmode=External %effcharge=95 %effdischarge=95

set voltagebases=[0.4]
calcvoltagebases
solve

